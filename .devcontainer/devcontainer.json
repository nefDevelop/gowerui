{
  "name": "gowerGUI (Wails + Go + SvelteKit)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "golang.go",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/build/**": true
        },
        "go.lintTool": "gofmt",
        "go.lintOnSave": "package"
      }
    }
  },
  "forwardPorts": [5173, 34115],
  "remoteUser": "vscode"
}